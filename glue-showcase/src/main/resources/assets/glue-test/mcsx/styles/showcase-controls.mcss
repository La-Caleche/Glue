.ui-screen {
    padding: 0px;
    gap: 0px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

.ui-viewport {
    width: 100%;
    padding: 24px;
    gap: 0px;
    align-items: center;
    justify-content: center;
    background: transparent;
}

.ui-card {
    width: 100%;
    max-width: 760px;
    padding: 0px;
    gap: 0px;
    align-items: stretch;
    justify-content: start;
    background: @surface;
    corner-radius: @shell-radius;
}

Text {
    color: @text-primary;
    text-size: 13px;
}

.control-header {
    width: 100%;
    padding: 20px;
    gap: 4px;
    background: @surface-header;
}

.control-header > .ui-heading {
    width: 100%;
    text-size: 20px;
}

.control-header > .ui-copy {
    width: 100%;
    color: @text-subtitle;
    text-size: 13px;
}

.control-keybinds {
    width: 100%;
    padding: 0px;
    gap: 16px;
    align-items: center;
    justify-content: start;
    background: transparent;
}

.control-keybind {
    padding: 0px;
    gap: 6px;
    align-items: center;
    justify-content: start;
    background: transparent;
}

.control-keybind-keycap {
    padding: 3px;
    gap: 0px;
    align-items: center;
    justify-content: center;
    background: @surface-raised;
    corner-radius: @corner-radius;
}

.control-keybind-key {
    color: @text-primary;
    text-size: 10px;
}

.control-keybind-label {
    color: @text-explanatory;
    text-size: 10px;
}

.control-body {
    width: 100%;
    padding: 24px;
    gap: 24px;
    align-items: stretch;
    background: @surface;
}

.control-columns {
    width: 100%;
    padding: 0px;
    gap: 8px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

.control-section {
    flex-grow: 1;
}

.ui-section {
    width: 100%;
    padding: 0px;
    gap: 8px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

.ui-section-title {
    width: 100%;
    color: @text-label;
    text-size: 10px;
}

.ui-actions {
    width: 100%;
    padding: 0px;
    gap: 8px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

.ui-actions > Button {
    flex-grow: 1;
}

.control-footer {
    width: 100%;
    padding: 12px;
    gap: 8px;
    align-items: center;
    justify-content: end;
    background: @surface-footer;
}

.control-footer > Button {
    width: 128px;
    control-height: @control-height;
    text-size: 13px;
}

.control-status {
    flex-grow: 1;
    color: @text-meta;
    text-size: 10px;
}

.dialog-card {
    max-width: 520px;
}

.dialog-actions {
    width: 100%;
    padding: 24px;
    gap: 8px;
    align-items: center;
    background: @surface;
}

.dialog-actions > Button {
    width: 300px;
}

.dialog-status {
    flex-grow: 1;
    color: @text-meta;
    text-size: 10px;
}
