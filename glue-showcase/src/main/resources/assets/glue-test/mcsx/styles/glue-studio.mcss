/* Glue Studio uses the shared MCSX neutral surfaces and 4px spacing rhythm. */

Row {
    padding: 0px;
    gap: 8px;
    align-items: center;
    background: transparent;
}

Column {
    padding: 0px;
    gap: 8px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

Text {
    color: @text-primary;
    text-size: 12px;
}

TextField {
    corner-radius: @corner-radius;
    control-height: @control-height;
    text-size: 13px;
    background: @surface-well;
}

TextField:focus {
    background: @surface-well;
}

Checkbox {
    color: @text-muted;
    control-height: @control-height;
    text-size: 13px;
}

Checkbox:checked {
    color: @text-primary;
}

/* The root paints nothing so the running world shows through the viewport pane and the gutters.
   Header, footer and every other leaf carry their own opaque background. */
.dockspace-scope {
    padding: 0px;
    gap: 0px;
    align-items: stretch;
    background: transparent;
}

/* Chrome */

.studio-header {
    width: 100%;
    padding: 12px;
    gap: 8px;
    background: @surface-header;
}

.studio-header > Button {
    width: 108px;
    control-height: @control-height;
    text-size: 13px;
}

.studio-brand {
    flex-grow: 1;
    gap: 4px;
}

.studio-brand > .ui-heading {
    color: @text-primary;
    text-size: 17px;
}

.studio-brand > .ui-copy {
    color: @text-subtitle;
    text-size: 12px;
}

.studio-footer {
    width: 100%;
    padding: 12px;
    gap: 8px;
    color: @text-meta;
    background: @surface-footer;
    text-size: 11px;
}

.studio-footer > Text {
    color: @text-meta;
    text-size: 11px;
}

.studio-status {
    flex-grow: 1;
    color: @text-muted;
    text-size: 11px;
}

.studio-pane-tools {
    gap: 8px;
    justify-content: end;
}

.studio-span {
    color: @text-meta;
    text-size: 10px;
}

.studio-tool {
    width: 80px;
    control-height: 22px;
    text-size: 10px;
}

/* Pane body */

.studio-pane {
    width: 100%;
    padding: 16px;
    gap: 20px;
}

.studio-hint {
    color: @text-explanatory;
    text-size: 12px;
}

.studio-empty {
    width: 100%;
    padding: 12px;
    background: @surface-well;
    corner-radius: @corner-radius;
}

.studio-empty > Text {
    color: @text-explanatory;
    text-size: 12px;
}

.studio-validation {
    color: @danger-line;
    text-size: 11px;
}

.studio-list {
    width: 100%;
    gap: 4px;
}

.ui-section {
    width: 100%;
    padding: 0px;
    gap: 8px;
    background: transparent;
}

.ui-section > .ui-section-title {
    color: @text-label;
    text-size: 10px;
}

.ui-actions {
    width: 100%;
    gap: 8px;
}

.ui-actions > Button {
    flex-grow: 1;
    text-size: 13px;
}

/* Light list */

.studio-row {
    width: 100%;
    padding: 8px;
    gap: 4px;
    background: transparent;
    corner-radius: @corner-radius;
}

.studio-row:hover {
    background: @surface-hover;
}

.studio-row:selected {
    background: @surface-raised;
}

.studio-row-head {
    width: 100%;
    gap: 8px;
}

.studio-row-text {
    flex-grow: 1;
    gap: 4px;
}

.studio-row-title {
    flex-grow: 1;
    color: @text-primary;
    text-size: 13px;
}

.studio-row-detail {
    color: @text-explanatory;
    text-size: 10px;
}

.studio-row-distance {
    width: 40px;
    color: @text-meta;
    text-size: 11px;
}

/* Inspector */

.studio-form {
    width: 100%;
    gap: 20px;
}

.studio-selected {
    width: 100%;
    padding: 12px;
    gap: 8px;
    background: @surface-well;
    corner-radius: @corner-radius;
}

.studio-selected-title {
    color: @text-primary;
    text-size: 16px;
}

.studio-selected-position {
    color: @text-meta;
    text-size: 11px;
}

.studio-swatches {
    width: 100%;
    gap: 8px;
    justify-content: start;
}

.studio-numbers {
    width: 100%;
    gap: 8px;
    align-items: end;
}

.studio-number {
    flex-grow: 1;
    gap: 4px;
}

.studio-field-label {
    color: @text-label;
    text-size: 10px;
}

.studio-stepper {
    width: 100%;
    gap: 8px;
}

.studio-stepper-label {
    flex-grow: 1;
    color: @text-meta;
    text-size: 11px;
}

.studio-step {
    width: 32px;
    control-height: 22px;
    text-size: 11px;
}

.studio-step-field {
    width: 64px;
}

/* Effects and palette */

.studio-effect {
    width: 100%;
    control-height: @control-height;
    text-size: 13px;
}

.studio-log-entry {
    width: 100%;
    padding: 8px;
    background: @surface-well;
    corner-radius: @corner-radius;
}

.studio-log-entry > Text {
    color: @text-meta;
    text-size: 10px;
}
