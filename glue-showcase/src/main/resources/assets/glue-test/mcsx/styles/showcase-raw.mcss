.raw-scope-demo {
    width: 100%;
    padding: 12px;
    gap: 8px;
    align-items: stretch;
    justify-content: start;
    background: @surface-well;
    corner-radius: @corner-radius;
}

.raw-scope-demo > Text {
    width: 100%;
    color: @text-explanatory;
    text-size: 12px;
}

.raw-scope-demo > Button {
    width: 100%;
    color: @text-primary;
    background: transparent;
    corner-radius: @corner-radius;
    control-height: @control-height;
    text-size: 13px;
    font-weight: normal;
    elevation: 0px;
    top-highlight: transparent;
    top-highlight-height: 0px;
}

.raw-scope-demo > Button:hover {
    background: @surface-hover;
}

.raw-scope-demo > Button:pressed {
    color: @text-muted;
    background: @surface-pressed;
}

.raw-scope-demo > Button:disabled {
    color: @text-disabled;
    background: @surface-disabled;
}
