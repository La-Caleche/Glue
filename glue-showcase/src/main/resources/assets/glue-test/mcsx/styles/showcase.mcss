.ui-screen {
    padding: 0px;
    gap: 0px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

.ui-viewport {
    width: 100%;
    padding: 24px;
    gap: 0px;
    align-items: center;
    justify-content: center;
    background: transparent;
}

.ui-card {
    width: 100%;
    max-width: 720px;
    padding: 24px;
    gap: 24px;
    align-items: stretch;
    justify-content: start;
    background: @surface;
    corner-radius: @shell-radius;
}

Text {
    color: @text-primary;
}

.ui-heading {
    width: 100%;
    text-size: 20px;
}

.ui-copy {
    width: 100%;
    color: @text-explanatory;
    text-size: 13px;
}

TextField {
    color: @text-primary;
    background: @surface-well;
    corner-radius: @corner-radius;
    control-height: @control-height;
}

.ui-field {
    width: 100%;
    text-size: 13px;
}

.editor {
    background: @surface-well;
}

.ui-section {
    width: 100%;
    padding: 0px;
    gap: 8px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

.ui-section-title {
    width: 100%;
    color: @text-label;
    text-size: 10px;
}

.counter-value {
    width: 100%;
    text-size: 20px;
}

.ui-actions {
    width: 100%;
    padding: 0px;
    gap: 8px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

.ui-actions > Button {
    flex-grow: 1;
}

.form-field:invalid {
    color: @danger-text;
    background: @danger-field;
}

.form-error {
    color: @danger-line;
}

.form-focus {
    color: @text-meta;
}

.form-success {
    color: @text-primary;
}

Checkbox {
    color: @text-muted;
    control-height: @control-height;
    text-size: 13px;
}

Checkbox:checked {
    color: @text-primary;
}

Checkbox:disabled {
    color: @text-disabled;
}

Checkbox:hover {
    color: @text-primary;
}

Checkbox:focus {
    color: @text-primary;
}

.ui-list {
    width: 100%;
    padding: 0px;
    gap: 8px;
    align-items: stretch;
    justify-content: start;
    background: transparent;
}

.item-row {
    width: 100%;
    padding: 0px;
    gap: 8px;
    align-items: center;
    justify-content: start;
    background: transparent;
}

.item-row > TextField {
    flex-grow: 1;
    text-size: 13px;
}

.danger {
    width: 96px;
}

.footer-actions {
    padding: 12px;
    background: @surface-footer;
    corner-radius: @shell-radius;
}
