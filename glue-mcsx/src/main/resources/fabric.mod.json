    "name": "Glue MCSX",
    "description": "MCSX: ModernUI components with Taffy layout and reactive properties",
    "authors": [
        "Malo <malo@lacaleche.cc>",
        "Theo <theo@lacaleche.cc>"
    ],
    "contact": {
